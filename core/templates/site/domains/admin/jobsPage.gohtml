{{ template "head" $ }}
<div>[<a href="/admin">Admin:</a> <a href="/admin/jobs">(This page/Refresh)</a>]</div>
<h2>Durable Background Jobs</h2>

{{- if .FlashError }}
<p style="color: #b00020;"><strong>Error:</strong> {{ .FlashError }}</p>
{{- end }}

<form method="get" action="/admin/jobs" style="margin-bottom: 16px;">
    <label>Status:
        <select name="status">
            <option value=""{{ if eq .StatusFilter "" }} selected{{ end }}>All</option>
            <option value="pending"{{ if eq .StatusFilter "pending" }} selected{{ end }}>Pending</option>
            <option value="running"{{ if eq .StatusFilter "running" }} selected{{ end }}>Running</option>
            <option value="failed"{{ if eq .StatusFilter "failed" }} selected{{ end }}>Failed</option>
            <option value="completed"{{ if eq .StatusFilter "completed" }} selected{{ end }}>Completed</option>
            <option value="cancelled"{{ if eq .StatusFilter "cancelled" }} selected{{ end }}>Cancelled</option>
        </select>
    </label>
    <label>Type:
        <input type="text" name="type" value="{{ .TypeFilter }}" placeholder="external_link / image_cache / search_index" />
    </label>
    <button type="submit">Filter</button>
</form>

<h3>Enqueue External URL Metadata Fetch</h3>
<form method="post" action="/admin/jobs" style="margin-bottom: 16px;">
    {{ csrfField }}
    <input type="hidden" name="action" value="enqueue_url" />
    <input type="url" name="url" placeholder="https://example.com/article" required style="width: 360px;" />
    <label><input type="checkbox" name="force" value="1" /> Force (ignore cooldown)</label>
    <button type="submit">Enqueue URL</button>
</form>

<form method="post" action="/admin/jobs" style="margin-bottom: 16px;">
    {{ csrfField }}
    <input type="hidden" name="action" value="purge" />
    <input type="hidden" name="status" value="{{ .StatusFilter }}" />
    <button type="submit">Purge Terminal Jobs (Preserves Cooldowns)</button>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Status</th>
            <th>Target</th>
            <th>Attempts</th>
            <th>Lease</th>
            <th>Error</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {{- range .Jobs }}
        <tr>
            <td>{{ .ID }}</td>
            <td>{{ .JobType }}</td>
            <td>{{ .Status }}</td>
            <td>{{ .TargetKey }}</td>
            <td>{{ .Attempts }} / {{ .MaxAttempts }}</td>
            <td>{{ if .LeaseOwner.Valid }}{{ .LeaseOwner.String }}{{ end }}</td>
            <td>{{ if .LastError.Valid }}{{ .LastError.String }}{{ end }}</td>
            <td>
                {{- if or (eq .Status "failed") (eq .Status "cancelled") (eq .Status "completed") }}
                <form method="post" action="/admin/jobs" style="display:inline;">
                    {{ csrfField }}
                    <input type="hidden" name="action" value="retry" />
                    <input type="hidden" name="id" value="{{ .ID }}" />
                    <button type="submit">Retry</button>
                </form>
                {{- end }}
                {{- if or (eq .Status "pending") (eq .Status "running") }}
                <form method="post" action="/admin/jobs" style="display:inline;">
                    {{ csrfField }}
                    <input type="hidden" name="action" value="cancel" />
                    <input type="hidden" name="id" value="{{ .ID }}" />
                    <button type="submit">Cancel</button>
                </form>
                {{- end }}
            </td>
        </tr>
    {{- else }}
        <tr><td colspan="8">No durable jobs found.</td></tr>
    {{- end }}
    </tbody>
</table>
{{ template "tail" $ }}
