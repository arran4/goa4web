{{ template "head" . }}
<link rel="stylesheet" href="{{ assetHash "/forum/forum.css" }}">
<script src="{{ assetHash "/forum/forum.js" }}"></script>

<h1 class="page-title">Replies to <a href="{{ cd.ForumBasePath }}/topic/{{.Topic.Idforumtopic}}/thread/{{.Thread.Idforumthread}}">Thread #{{.Thread.Idforumthread}}</a></h1>

{{ if eq (len .ForksByComment) 0 }}
    <p>No replies found.</p>
{{ else }}
    {{ $base := "/forum" }}
    {{ with cd.ForumBasePath }}{{ $base = . }}{{ end }}
    {{ range $commentID, $group := .ForksByComment }}
        <div class="comment-group" id="comment-{{ $commentID }}">
            <h2 style="margin-top: 2rem; border-bottom: 2px solid #ccc; padding-bottom: 0.5rem;">
                {{ if eq $commentID 0 }}
                    Replies to Thread
                {{ else }}
                    Replies to Comment <a href="{{ $base }}/topic/{{$.Topic.Idforumtopic}}/thread/{{$.Thread.Idforumthread}}#comment-{{ $commentID }}">#{{ $commentID }}</a>
                {{ end }}
            </h2>
            <div class="thread-list">
            {{- range $group.Threads }}
                <div class="thread" data-last-reply-time="{{ .LastAddition.Unix }}" data-creation-time="{{ .FirstPostWritten.Unix }}" data-comments="{{ .CommentCount }}">
                    <div class="thread-meta thread-header">
                        Forked by: <span class="poster-name first" {{ if ne .FirstPosterID cd.UserID }}style="font-weight: bold;"{{ end }}>{{ .FirstPoster }}</span>
                        At <span class="post-time first">{{ cd.LocalTime .FirstPostWritten }}</span>
                        {{ template "topicLabels" .Labels }}
                    </div>
                    <div class="thread-content foldable">
                        {{ .FirstPostText | a4code2html }}<br>
                    </div>
                    <div class="thread-meta">
                        Lastposter: <span class="poster-name last" {{ if ne .LastPosterID cd.UserID }}style="font-weight: bold;"{{ end }}>{{ .LastPoster }}</span>
                        At <span class="post-time last">{{ cd.LocalTime .LastAddition }}</span>
                        [<a href="{{$base}}/topic/{{.TopicID}}/thread/{{ .ThreadID }}">
                            {{- .CommentCount }} comments.</a>]
                    </div>
                </div>
            {{- end }}
            </div>
        </div>
    {{ end }}
{{ end }}

<div class="back-link" style="margin-top: 1rem;">
    <a href="{{ cd.ForumBasePath }}/topic/{{.Topic.Idforumtopic}}/thread/{{.Thread.Idforumthread}}">← Back to Thread</a>
</div>

{{ template "tail" . }}
