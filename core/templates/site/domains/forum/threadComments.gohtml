{{ define "threadComments" }}
    {{ if gt (cd.Offset) 0 }}
        <br>Skipping {{ cd.Offset }} comments.<br><br><br>
    {{ end }}
    <section class="comments">
        {{ $prev := 0 }}
        {{ $base := "/forum" }}
        {{ with .BasePath }}{{ $base = . }}{{ end }}
        {{ $topicID := 0 }}
        {{ if .Topic }}{{ $topicID = .Topic.Idforumtopic }}{{ end }}
        {{ $threadID := 0 }}
        {{ if .Thread }}{{ $threadID = .Thread.Idforumthread }}{{ end }}
        {{ $forkGroups := .ForksByComment }}

        {{ range $i, $c := cd.SelectedSectionThreadComments }}
            {{ $num := add (add $i 1) (cd.Offset) }}
            <hr id="c{{ $num }}">

            {{ $forkGroup := index $forkGroups $c.Idcomments }}

            {{ $forkListURL := "" }}
            {{ if and (gt $topicID 0) (gt $threadID 0) }}
                {{ $forkListURL = printf "%s/topic/%d/thread/%d/replies#comment-%d" $base $topicID $threadID $c.Idcomments }}
            {{ end }}

            {{ template "comment" (dict "Comment" $c "Number" $num "Prev" $prev "CanFork" $.CanFork) }}
            {{ if $forkGroup }}
                <div class="forked-banner" style="color: #666; font-size: 0.9em; margin-top: 5px; margin-bottom: 15px; border-left: 2px solid #ccc; padding-left: 10px;">
                    <em>Forked here:</em>
                    {{ range $index, $fork := $forkGroup.Threads }}
                        <a href="{{ $base }}/topic/{{ $fork.TopicID }}/thread/{{ $fork.ThreadID }}">Thread #{{ $fork.ThreadID }}</a> by {{ $fork.FirstPoster }} — last reply by {{ $fork.LastPoster }} {{ timeAgo (cd.LocalTime $fork.LastAddition) }},
                    {{ end }}
                    <a href="{{ $forkListURL }}">See all {{ $forkGroup.Total }} replies</a>
                </div>
            {{ end }}
            {{ $prev = $c }}
        {{ else }}
            No comments.
        {{ end }}
    </section>
{{ end }}
