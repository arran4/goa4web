{{ template "head" $ }}
<link rel="stylesheet" href="{{ assetHash "/forum/forum.css" }}">
<script src="{{ assetHash "/forum/forum.js" }}"></script>
    {{ if .Category }}
        <h1>Category: {{ .Category.Title.String }}</h1>
    {{ end }}
{{ $topicTitle := topicTitleOrDefault .Topic.Title.String }}
{{ if .Topic.DisplayTitle }}{{ $topicTitle = topicTitleOrDefault .Topic.DisplayTitle }}{{ end }}
<h2>Topic: {{ $topicTitle }}</h2>
{{ if .CanFollowNewThreads }}
    {{ if .FollowsForumNewThreads }}
        <p>You follow new threads from the <a href="/forum">public forum</a>.</p>
    {{ end }}
    {{ if .Subscribed }}
        <form action="{{ .BasePath }}/topic/{{ .Topic.Idforumtopic }}/unsubscribe" method="post">
            {{ csrfField }}
            <button type="submit" name="task" value="Unsubscribe From Topic">Remove direct topic follow</button>
        </form>
    {{ else }}
        <form action="{{ .BasePath }}/topic/{{ .Topic.Idforumtopic }}/subscribe" method="post">
            {{ csrfField }}
            <button type="submit" name="task" value="Subscribe To Topic">Follow new threads in this topic</button>
        </form>
    {{ end }}
{{ end }}
    {{ if gt (len .Labels) 0 }}
        {{ template "topicLabels" .Labels }}
    {{ end }}

    {{ template "topicThreads" $ }}

    {{ template "partials/common/_share.gohtml" (dict "module" "forum" "link" (printf "/forum/topic/%d" .Topic.Idforumtopic)) }}
{{ template "tail" $ }}
