{{ template "head" $ }}
<h2>Advanced subscriptions</h2>
<p><a href="/usr/subscriptions">Subscription overview</a></p>

<form method="post" action="/usr/subscriptions/update" data-subscription-editor>
    {{ csrfField }}

    <div style="margin-bottom: 20px; padding: 10px; border: 1px solid #ccc;" data-subscription-shortcuts hidden>
        <strong>Global Controls:</strong>
        <span style="margin-left: 20px;">
            Internal:
            <button type="button" data-subscription-channel="internal" data-subscription-selection="all" hidden>All</button>
            <button type="button" data-subscription-channel="internal" data-subscription-selection="none" hidden>None</button>
            <button type="button" data-subscription-channel="internal" data-subscription-selection="invert" hidden>Invert</button>
        </span>
        <span style="margin-left: 20px;">
            Email:
            <button type="button" data-subscription-channel="email" data-subscription-selection="all" hidden>All</button>
            <button type="button" data-subscription-channel="email" data-subscription-selection="none" hidden>None</button>
            <button type="button" data-subscription-channel="email" data-subscription-selection="invert" hidden>Invert</button>
        </span>
    </div>

    {{ range .Groups }}
        {{ template "subscriptionGroup" . }}
    {{ end }}

    {{ if .IsAdminMode }}
        {{ if .AdminGroups }}
            <hr>
            <h2>Admin Subscriptions</h2>
            {{ range .AdminGroups }}
                {{ template "subscriptionGroup" . }}
            {{ end }}
        {{ end }}
    {{ end }}

    <p>
        <input type="submit" value="Update Subscriptions" class="button">
    </p>
</form>

<p>
    <a href="/usr/subscriptions/add" class="button">Add Subscription</a>
    <a href="/usr/subscriptions/threads" class="button">Manage Thread Subscriptions</a>
</p>


{{ template "tail" $ }}

{{ define "subscriptionGroup" }}
    {{ $group := . }}
    <div class="subscription-group">
        <h3>{{ .Name }}</h3>
        <p>{{ .Description }}</p>

        {{ if .Instances }}
        <table>
            <thead>
                <tr>
                    <th>Target</th>
                    <th>
                        Internal<br>
                        <button type="button" data-subscription-channel="internal" data-subscription-selection="all" hidden>All</button>
                        <button type="button" data-subscription-channel="internal" data-subscription-selection="none" hidden>None</button>
                        <button type="button" data-subscription-channel="internal" data-subscription-selection="invert" hidden>Invert</button>
                    </th>
                    <th>
                        Email<br>
                        <button type="button" data-subscription-channel="email" data-subscription-selection="all" hidden>All</button>
                        <button type="button" data-subscription-channel="email" data-subscription-selection="none" hidden>None</button>
                        <button type="button" data-subscription-channel="email" data-subscription-selection="invert" hidden>Invert</button>
                    </th>
                    {{ if .SupportsAutoSubscribe }}
                    <th>
                        Auto-subscribe Internal<br>
                        <button type="button" data-subscription-channel="autosub_internal" data-subscription-selection="all" hidden>All</button>
                        <button type="button" data-subscription-channel="autosub_internal" data-subscription-selection="none" hidden>None</button>
                        <button type="button" data-subscription-channel="autosub_internal" data-subscription-selection="invert" hidden>Invert</button>
                    </th>
                    <th>
                        Auto-subscribe Email<br>
                        <button type="button" data-subscription-channel="autosub_email" data-subscription-selection="all" hidden>All</button>
                        <button type="button" data-subscription-channel="autosub_email" data-subscription-selection="none" hidden>None</button>
                        <button type="button" data-subscription-channel="autosub_email" data-subscription-selection="invert" hidden>Invert</button>
                    </th>
                    {{ end }}
                </tr>
            </thead>
            <tbody>
                {{ $defPattern := .Pattern }}
                {{ range .Instances }}
                {{ $pattern := .Original }}
                {{ if eq $pattern "" }}{{ $pattern = $defPattern }}{{ end }}
                <tr>
                    <td>
                        {{/* Display parameters nicely */}}
                        {{ if .Parameters }}
                            {{ range .Parameters }}
                                {{ .Key }}:
                                {{ if .Link }}
                                    <a href="{{ .Link }}">{{ if .Resolved }}{{ .Resolved }}{{ else }}{{ .Value }}{{ end }}</a>
                                {{ else }}
                                    {{ if .Resolved }}{{ .Resolved }}{{ else }}{{ .Value }}{{ end }}
                                {{ end }}
                            {{ end }}
                        {{ else }}
                            All
                        {{ end }}
                    </td>
                    <td>
                        {{ if $group.Mandatory }}
                            <input type="checkbox" checked disabled>
                            <span style="font-size: 0.8em; color: gray;">(Mandatory)</span>
                            <input type="hidden" name="presented_subs" value="{{ $pattern }}|internal">
                        {{ else }}
                            <input type="checkbox" name="subs" value="{{ $pattern }}|internal" {{ if .HasMethod "internal" }}checked{{ end }}>
                            <input type="hidden" name="presented_subs" value="{{ $pattern }}|internal">
                        {{ end }}
                    </td>
                    <td>
                        {{ if $group.Mandatory }}
                            <input type="checkbox" checked disabled>
                            <span style="font-size: 0.8em; color: gray;">(Mandatory)</span>
                            <input type="hidden" name="presented_subs" value="{{ $pattern }}|email">
                        {{ else }}
                            <input type="checkbox" name="subs" value="{{ $pattern }}|email" {{ if .HasMethod "email" }}checked{{ end }}>
                            <input type="hidden" name="presented_subs" value="{{ $pattern }}|email">
                        {{ end }}
                    </td>
                    {{ if $group.SupportsAutoSubscribe }}
                    <td>
                        <input type="checkbox" name="subs" value="{{ $pattern }}|autosub_internal" {{ if .HasMethod "autosub_internal" }}checked{{ end }}>
                        <input type="hidden" name="presented_subs" value="{{ $pattern }}|autosub_internal">
                    </td>
                    <td>
                        <input type="checkbox" name="subs" value="{{ $pattern }}|autosub_email" {{ if .HasMethod "autosub_email" }}checked{{ end }}>
                        <input type="hidden" name="presented_subs" value="{{ $pattern }}|autosub_email">
                    </td>
                    {{ end }}
                </tr>
                {{ end }}
            </tbody>
        </table>
        {{ else }}
        <p>No subscriptions.</p>
        {{ end }}
    </div>
{{ end }}
