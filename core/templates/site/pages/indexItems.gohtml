{{- define "indexItems"}}
    {{ range $i := cd.IndexItems }}
        <a href="{{ addmode $i.Link }}" {{ if eq $i.Link "/usr/notifications" }}id="notif-index" data-live-target="notifications-count" data-live-event="notification" data-live-url="/usr/notifications/fragment/count" data-live-swap="outerHTML"{{ end }} style="text-decoration: none;">{{ if $i.Icon }}{{ $i.Icon }}&nbsp;{{ end }}<span style="text-decoration: underline;">{{ $i.Name }}</span></a><br>
    {{ end }}
{{- end}}
