{{ define "notificationsCountFragment" }}<a href="/usr/notifications" id="notif-index" data-live-target="notifications-count" data-live-event="notification" data-live-url="/usr/notifications/fragment/count" data-live-swap="outerHTML" style="text-decoration: none;">🔔&nbsp;<span style="text-decoration: underline;">Notifications</span>{{ if gt cd.NotificationCount 0 }} <span style="text-decoration: underline;">({{ cd.NotificationCount }})</span>{{ end }}</a>{{ end }}
